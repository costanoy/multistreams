# Copie para .env e preencha.
# O build de produção (npm run release) para se o Supabase ou o Client ID da Twitch estiverem vazios.
# Valores só de produção podem ficar num .env.production, que no build vale mais que este .env.

# URL do worker (pasta ../worker). No celular, use o IP da máquina na rede, não localhost.
# O build de produção troca pela URL do worker no Render.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase (opcional no desenvolvimento): login, sincronização, push e importação de seguidos.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Client ID do app da Twitch (é público), usado na importação de seguidos. Tem de ser o do MESMO app
# configurado no provedor Twitch do Supabase: o token do login sai desse app, e com o Client ID de outro
# app a Twitch responde 401 e a importação não funciona. O worker pode usar o mesmo app (TWITCH_CLIENT_ID).
EXPO_PUBLIC_TWITCH_CLIENT_ID=
