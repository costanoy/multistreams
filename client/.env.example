# Copie para .env e preencha.

# URL do worker (pasta ../worker). No celular, use o IP da máquina na rede, não localhost.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Supabase (opcional): login, sincronização, push e importação de seguidos.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Client ID do app da Twitch (o mesmo do worker; é público). Usado na importação de seguidos.
EXPO_PUBLIC_TWITCH_CLIENT_ID=
