# Copie para .env e preencha. Plataformas sem credencial ficam desligadas (o resto funciona).

PORT=8787

# Twitch — https://dev.twitch.tv/console/apps (Client ID + Client Secret)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials (API key)
YOUTUBE_API_KEY=

# Kick — https://kick.com/settings/developer (Client ID + Client Secret)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Supabase (opcional): persiste os canais acompanhados e habilita o push.
# Rode supabase/schema.sql num banco novo, ou supabase/migrations/20261028_endurecimento.sql num que já existe.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# EventSub da Twitch (opcional): URL pública https deste worker + um segredo qualquer (10 a 100 caracteres).
# Sem isso, a Twitch é consultada só por polling (a cada 60s).
PUBLIC_URL=
TWITCH_EVENTSUB_SECRET=

# Cota diária do YouTube (vira à meia-noite do Pacífico; a conta fica na tabela kv do Supabase).
# Desde 01/06/2026 o search.list tem balde próprio: 100 chamadas por dia, 1 por chamada.
# Os outros métodos (videos.list, channels.list...) dividem as 10.000 unidades, 1 por chamada.
YOUTUBE_UNITS_PER_DAY=10000
YOUTUBE_SEARCHES_PER_DAY=100

# Lista "tudo ao vivo" do YouTube: de quantos em quantos minutos redescobrir quem está no ar.
# Cada redescoberta gasta 1 das buscas do dia por língua.
BROWSE_YOUTUBE_MINUTES=120
# Quanto de cada balde essa lista pode gastar por dia; o resto fica para a busca por nome e os canais seguidos.
BROWSE_YOUTUBE_SEARCHES=60
BROWSE_YOUTUBE_BUDGET=6000

# Intervalos de polling, em segundos
POLL_TWITCH=60
POLL_KICK=60
POLL_YOUTUBE=180

# Proteções das rotas públicas. Os limites por IP são folgados porque muita gente divide o mesmo IP
# na rede móvel (CGNAT); no Render, o IP vem do CF-Connecting-IP que a Cloudflare grava. No IPv6 cada
# /64 conta como um IP, e a rede /48 inteira tem limites próprios de 5 vezes os do IP (no /status, só
# o de 10 min).
# Teto de canais acompanhados: acima dele, os canais novos ficam sem status (nada é tirado do registro).
# Os seguidos por alguma conta têm prioridade e entram até o dobro.
MAX_CHANNELS=20000
# Canais novos que o /status registra (no máximo 100 por pedido): por IP a cada 10 min e a cada 24 h,
# e somando todos os IPs a cada 10 min. O que não couber fica sem status naquele pedido, sem erro.
NEW_CHANNELS_PER_IP=300
NEW_CHANNELS_PER_IP_DAY=1000
NEW_CHANNELS_PER_WINDOW=2000
# Seguidos de uma conta que o worker acompanha; o resto é ignorado. O banco também ignora, sem erro,
# os seguidos novos de uma conta que já tem 3.000 (gatilho da migração 20261028).
FOLLOWS_PER_ACCOUNT=3000
# /search e /resolve fora do cache: pedidos por IP a cada 10 min e por minuto, e por minuto em cada
# plataforma somando todos os IPs. Passou, responde 429; o pedido recusado não gasta nenhum limite.
# O por minuto do IP fica bem abaixo do da plataforma: senão um IP sozinho fecha a busca para todos.
LOOKUPS_PER_IP=120
LOOKUPS_PER_IP_MINUTE=20
LOOKUPS_PER_MINUTE=60
