# Copie para .env e preencha. Plataformas sem credencial ficam desligadas (o resto funciona).

PORT=8787

# Twitch — https://dev.twitch.tv/console/apps (Client ID + Client Secret)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# YouTube Data API v3 — https://console.cloud.google.com/apis/credentials (API key)
YOUTUBE_API_KEY=

# Kick — https://kick.com/settings/developer (Client ID + Client Secret)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Supabase (opcional): persiste os canais acompanhados e habilita o push.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# EventSub da Twitch (opcional): URL pública https deste worker + um segredo qualquer (10 a 100 caracteres).
# Sem isso, a Twitch é consultada só por polling (a cada 60s).
PUBLIC_URL=
TWITCH_EVENTSUB_SECRET=

# Lista "tudo ao vivo" do YouTube: de quantos em quantos minutos redescobrir quem está no ar.
# Cada redescoberta custa 100 unidades de cota por língua (a cota diária padrão é 10.000).
BROWSE_YOUTUBE_MINUTES=60
# Teto de cota por dia para essa lista; o resto fica para os canais seguidos e para adicionar canais.
BROWSE_YOUTUBE_BUDGET=6000

# Intervalos de polling, em segundos
POLL_TWITCH=60
POLL_KICK=60
POLL_YOUTUBE=180
